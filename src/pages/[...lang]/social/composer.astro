---
// Post editor + per-network variants. Reachable from a calendar card with
// ?post=<id>, which the board renders into its edit links.
import Layout from '../../../layouts/Layout.astro';
import AuthGate from '../../../components/AuthGate.astro';
import AuthStatus from '../../../components/AuthStatus.astro';
import SocialCopy from '../../../components/social/SocialCopy.astro';
import VariantComposer from '../../../components/social/VariantComposer.astro';
import { localeOf, localePaths, t, unknownLocale } from '../../../lib/i18n';

export const getStaticPaths = localePaths;
if (unknownLocale(Astro)) return new Response(null, { status: 404 });
const locale = localeOf(Astro);
---

<Layout title={t(locale, 'social.composer.title')} locale={locale}>
  <h1>{t(locale, 'social.composer.title')}</h1>
  <p>{t(locale, 'social.composer.subtitle')}</p>
  <SocialCopy locale={locale} />
  <AuthGate locale={locale} />
  <AuthStatus locale={locale} />
  <VariantComposer locale={locale} />
</Layout>
