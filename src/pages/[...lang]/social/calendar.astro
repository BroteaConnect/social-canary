---
// Week view of the content calendar. One file, every language: getStaticPaths
// generates /social/calendar and /<code>/social/calendar for each shipped
// locale (docs/i18n-contract.md).
import Layout from '../../../layouts/Layout.astro';
import CalendarBoard from '../../../components/social/CalendarBoard.astro';
import AuthGate from '../../../components/AuthGate.astro';
import AuthStatus from '../../../components/AuthStatus.astro';
import SocialCopy from '../../../components/social/SocialCopy.astro';
import { localeOf, localePaths, t, unknownLocale } from '../../../lib/i18n';

export const getStaticPaths = localePaths;
if (unknownLocale(Astro)) return new Response(null, { status: 404 });
const locale = localeOf(Astro);
---

<Layout title={t(locale, 'social.calendar.title')} locale={locale}>
  <h1>{t(locale, 'social.calendar.title')}</h1>
  <p>{t(locale, 'social.calendar.subtitle')}</p>
  <SocialCopy locale={locale} />
  <AuthGate locale={locale} />
  <AuthStatus locale={locale} />
  <CalendarBoard locale={locale} />
</Layout>
