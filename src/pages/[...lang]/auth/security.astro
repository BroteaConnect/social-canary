---
// The identity's own security settings. Behind the gate like anything else:
// the second factor of a session nobody has proven is not a meaningful thing to
// edit.
import Layout from '../../../layouts/Layout.astro';
import AuthGate from '../../../components/AuthGate.astro';
import AuthStatus from '../../../components/AuthStatus.astro';
import MfaEnroll from '../../../components/MfaEnroll.astro';
import { localeOf, localePaths, t, unknownLocale } from '../../../lib/i18n';

export const getStaticPaths = localePaths;
if (unknownLocale(Astro)) return new Response(null, { status: 404 });
const locale = localeOf(Astro);
---

<Layout title={t(locale, 'auth.security.title')} locale={locale}>
  <AuthGate locale={locale} />
  <AuthStatus locale={locale} />
  <MfaEnroll locale={locale} />
</Layout>
