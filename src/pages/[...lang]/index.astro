---
// One file, every language: getStaticPaths generates / and /<code>/ for each
// locale in src/locales/config.json. Adding a language adds pages by itself.
import Layout from '../../layouts/Layout.astro';
import { localeOf, localePaths, t, unknownLocale } from '../../lib/i18n';

// Both lines, and both are load-bearing: `getStaticPaths` generates the
// pages on a static stack, and `localeOf` is what reads the language on a
// server one, where getStaticPaths is ignored.
export const getStaticPaths = localePaths;
if (unknownLocale(Astro)) return new Response(null, { status: 404 });
const locale = localeOf(Astro);
---

<Layout title="Social Canary" locale={locale}>
  <h1>Social Canary</h1>
  <p>{t(locale, 'home.tagline')}</p>
  <p>{t(locale, 'home.generated', { stack: 'astro' })}</p>
</Layout>
