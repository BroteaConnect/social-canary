{
  "schema": 2,
  "composer": "0.6.0",
  "stack": "astro",
  "template": {
    "name": "astro",
    "version": "1.0.0"
  },
  "project": {
    "slug": "social-canary",
    "name": "Social Canary",
    "description": "F0 canary of the social publishing factory"
  },
  "runtime": {
    "port": 80,
    "health": "/"
  },
  "features": {
    "db": {
      "version": "1.3.0",
      "files": [
        "src/lib/pb.ts"
      ],
      "collections": [
        "users"
      ],
      "services": [
        "pocketbase"
      ]
    },
    "auth": {
      "version": "1.7.0",
      "files": [
        "src/components/AuthGate.astro",
        "src/components/AuthStatus.astro",
        "src/components/MfaEnroll.astro",
        "src/lib/auth.ts",
        "src/pages/[...lang]/auth/callback.astro",
        "src/pages/[...lang]/auth/security.astro"
      ],
      "services": [
        "supabase-auth"
      ]
    },
    "social-calendar": {
      "version": "2.0.0",
      "files": [
        "src/components/social/AssetLibrary.astro",
        "src/components/social/CalendarBoard.astro",
        "src/components/social/SocialCopy.astro",
        "src/components/social/VariantComposer.astro",
        "src/lib/social.ts",
        "src/pages/[...lang]/social/assets.astro",
        "src/pages/[...lang]/social/calendar.astro",
        "src/pages/[...lang]/social/composer.astro"
      ],
      "collections": [
        "assets",
        "brands",
        "posts",
        "variants"
      ]
    }
  },
  "theme": {
    "name": "brotea",
    "version": "2.1.0"
  },
  "i18n": {
    "defaultLocale": "es",
    "locales": [
      "en",
      "es"
    ],
    "required": [
      "en",
      "es"
    ],
    "runtime": "1.0.0"
  },
  "quality": {
    "version": "1.5.0"
  }
}
